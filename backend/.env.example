# Each agent has its own independent Gemini API key, loaded from its own
# environment variable, so keys can be managed/rotated independently
# without touching any code.
#
# Only the Chat, Quiz, and Citation Verifier agents currently make Gemini
# calls (the Research Agent uses DuckDuckGo web search; the Source Agent
# uses local embeddings), so only CHAT_AGENT_API_KEY is strictly required
# for the app to work today - Quiz and Citation Verifier fall back to it
# if their own key is left blank. RESEARCH/SOURCE are still loaded and a
# client is initialized for each at startup whenever they're set, ready
# for if/when those agents need one.
#
# Get a free key at https://aistudio.google.com/app/apikey
CHAT_AGENT_API_KEY=your_chat_agent_api_key_here
RESEARCH_AGENT_API_KEY=your_research_agent_api_key_here
SOURCE_AGENT_API_KEY=your_source_agent_api_key_here
QUIZ_AGENT_API_KEY=your_quiz_agent_api_key_here
VERIFIER_AGENT_API_KEY=your_verifier_agent_api_key_here
PODCAST_AGENT_API_KEY=your_podcast_agent_api_key_here

# Comma-separated list of models offered in the Settings page model picker.
AVAILABLE_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest

# Toggles the Citation Verifier's confidence badge on/off globally. The
# Chat Agent's core answer generation is never affected by this.
ENABLE_CITATION_VERIFIER=true

# Gemini model to use for chat/summarization.
GEMINI_MODEL=gemini-3.6-flash

# Where ChromaDB stores its persistent vector data (relative to backend/ folder)
CHROMA_PERSIST_DIR=./chroma_data

# Comma separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://source-mind-ai.vercel.app

# Max characters per text chunk when splitting documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved from the vector store per query
RETRIEVAL_TOP_K=5

# Similarity distance above which the system decides local sources are
# insufficient and triggers the Research Agent to search the web.
# (ChromaDB uses cosine distance: 0 = identical, 2 = opposite. Lower is better.)
RESEARCH_TRIGGER_DISTANCE=0.7
